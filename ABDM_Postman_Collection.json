              "mode": "raw",
              "raw": "{\n  \"loginId\": \"<Driving Licence number>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dl/enroll/send-otp",
              "host": ["{{base_url}}"],
              "path": ["dl", "enroll", "send-otp"]
