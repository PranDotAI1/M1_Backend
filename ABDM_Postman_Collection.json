        {
          "name": "Verify User (Account Verify)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "accesstoken", "value": "{{accessToken}}" },
              { "key": "t-token", "value": "<T-token from verify-otp>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"abhanumber\": \"<14-digit ABHA number>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/account/verify",
              "host": ["{{base_url}}"],
              "path": ["account", "verify"]
            }
          },
          "response": []
        }
      ]
