            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"otpValue\": \"<6-digit OTP>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dl/enroll/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["dl", "enroll", "verify-otp"]
            }
          },
          "response": []
        },
        {
          "name": "Create Enroll Number (DL)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "accesstoken", "value": "{{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"DL_number\": \"<DL number>\",\n  \"First_Name\": \"John\",\n  \"Middle_Name\": \"\",\n  \"Last_Name\": \"Doe\",\n  \"d_o_b\": \"1990-01-01\",\n  \"gender\": \"M\",\n  \"base_front_photo\": \"<base64 front image>\",\n  \"base_back_photo\": \"<base64 back image>\",\n  \"Address\": \"123 Main Street\",\n  \"state\": \"Maharashtra\",\n  \"District\": \"Pune\",\n  \"Pincode\": \"411001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dl/enroll/create-enroll-number",
              "host": ["{{base_url}}"],
              "path": ["dl", "enroll", "create-enroll-number"]
            }
          },
          "response": []
        }
      ]
    },
