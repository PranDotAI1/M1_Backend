{
  "info": {
    "name": "ABDM Backend API",
    "_postman_id": "abdm-backend-collection",
    "description": "Complete Postman collection for ABDM Backend API running on port 4200",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4200/api/abha",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "xToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "txnId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Get Access Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/token",
              "host": ["{{base_url}}"],
              "path": ["token"]
            },
            "description": "Fetches the ABDM access token. No body or headers required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Captcha",
      "item": [
        {
          "name": "Generate Captcha",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/captcha/generate",
              "host": ["{{base_url}}"],
              "path": ["captcha", "generate"]
            },
            "description": "Returns a base64 SVG captcha image and a sessionId."
          },
          "response": []
        },
        {
          "name": "Validate Captcha",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"<sessionId from generate>\",\n  \"captcha\": \"<user entered captcha text>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/captcha/validate",
              "host": ["{{base_url}}"],
              "path": ["captcha", "validate"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Enrollment via Aadhaar",
      "item": [
        {
          "name": "Send Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "accesstoken", "value": "{{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"<12-digit Aadhaar number>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/enrollment/aadhar/send-otp",
              "host": ["{{base_url}}"],
              "path": ["enrollment", "aadhar", "send-otp"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "accesstoken", "value": "{{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"otpValue\": \"<6-digit OTP>\",\n  \"mobile\": \"<10-digit mobile number>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/enrollment/aadhar/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["enrollment", "aadhar", "verify-otp"]
            }
          },
          "response": []
        },
        {
          "name": "Get ABHA Address Suggestions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "accesstoken", "value": "{{accessToken}}" },
              { "key": "transaction-id", "value": "{{txnId}}" }
            ],
            "url": {
              "raw": "{{base_url}}/enrollment/abha-address-suggestions",
              "host": ["{{base_url}}"],
              "path": ["enrollment", "abha-address-suggestions"]
            }
          },
          "response": []
        },
        {
          "name": "Create ABHA Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "accesstoken", "value": "{{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"txnId\": \"{{txnId}}\",\n  \"abhaAddress\": \"<desired ABHA address>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/enrollment/create-abha-address",
              "host": ["{{base_url}}"],
              "path": ["enrollment", "create-abha-address"]
            }
          },
          "response": []
        }
      ]
    },
